# Cloud PostgreSQL connection string (Neon, Vercel Postgres, Supabase Postgres, Railway, Render)
# Required when deploying to Vercel or any cloud serverless host so QR codes & scans persist permanently.
DATABASE_URL=

# Optional passcode to lock the admin dashboard (/) on the public internet.
# Leave empty locally to skip login; set a strong secret in Vercel Environment Variables before selling cards.
# Note: Public QR scan links (/r/<code>) always work worldwide without any passcode.
ADMIN_PASSCODE=

